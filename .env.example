# Gemini API key from Google AI Studio
GEMINI_API_KEY=your-key-here
# Model name - check Google's docs for the current list
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

# Selects the provider at application startup: gemini, azure, or mock
LLM_PROVIDER=azure
LLM_TEMPERATURE=0.7

# Azure OpenAI (used when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://aceint-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=key
# This must be your Azure deployment name
AZURE_OPENAI_MODEL=gpt-4.1-mini-test

# Folder holding the CSV dictionary
DATA_DIR=./data

# Competencies described in parallel
CONCURRENCY=3
# Rewrite attempts when a description fails the quality checks
MAX_REVISIONS=2
PORT=3000

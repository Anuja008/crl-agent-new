# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Google AI Studio key for Gemini Search grounding (no Search Engine ID needed).
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite

# Selects the provider at application startup: groq, azure, or mock
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.7

# Free plan has rate limits; generation uses about 10-11 calls per new role.

# Azure OpenAI (used when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://aceint-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=key
# This must be your Azure deployment name
AZURE_OPENAI_MODEL=gpt-4.1-mini-test

# Folder holding the CSV dictionary
DATA_DIR=./data

# Competencies described in parallel
CONCURRENCY=3
# Rewrite attempts when a description fails the quality checks
MAX_REVISIONS=2
PORT=3000
